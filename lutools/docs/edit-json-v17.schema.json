{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawLab edit recipe v17",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "processing",
    "input",
    "edits",
    "output"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 17
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "raw",
            "raster"
          ],
          "default": "raw"
        }
      }
    },
    "edits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure"
      ],
      "properties": {
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "scene",
                "preview",
                "sensor"
              ]
            },
            "ev": {
              "type": "number",
              "minimum": -20,
              "maximum": 20,
              "default": 0
            },
            "brightness": {
              "type": "number",
              "minimum": 1.1754943508222875e-38,
              "maximum": 3.4028234663852886e+38,
              "default": 1
            }
          }
        },
        "white_balance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "camera",
                "auto",
                "temperature",
                "relative",
                "none"
              ]
            },
            "temperature_kelvin": {
              "type": "number",
              "minimum": 2000,
              "maximum": 50000
            },
            "tint": {
              "type": "number",
              "minimum": -150,
              "maximum": 150,
              "default": 0
            },
            "relative_temperature": {
              "type": "number",
              "minimum": 2000,
              "maximum": 50000,
              "default": 6500
            },
            "relative_tint": {
              "type": "number",
              "minimum": -150,
              "maximum": 150,
              "default": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "temperature"
                  }
                }
              },
              "then": {
                "required": [
                  "temperature_kelvin"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "temperature_kelvin"
                      ]
                    },
                    {
                      "required": [
                        "tint"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "not": {
                  "properties": {
                    "mode": {
                      "const": "relative"
                    }
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "relative_temperature"
                      ]
                    },
                    {
                      "required": [
                        "relative_tint"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "default": null
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "crop": {
              "type": "object",
              "additionalProperties": false,
              "description": "Normalized rectangle after turns, flips, perspective and straightening; runtime also checks x+width and y+height <=1 with float boundary tolerance.",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1,
                  "default": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1,
                  "default": 0
                },
                "width": {
                  "type": "number",
                  "minimum": 1.1754943508222875e-38,
                  "maximum": 1,
                  "default": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 1.1754943508222875e-38,
                  "maximum": 1,
                  "default": 1
                }
              }
            },
            "quarter_turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "default": 0
            },
            "flip_horizontal": {
              "type": "boolean",
              "default": false
            },
            "flip_vertical": {
              "type": "boolean",
              "default": false
            },
            "straighten_degrees": {
              "type": "number",
              "minimum": -45,
              "maximum": 45,
              "default": 0
            },
            "perspective": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "horizontal": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "default": 0
                },
                "vertical": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "default": 0
                }
              }
            }
          }
        },
        "tone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contrast": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            },
            "saturation": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            },
            "highlights": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            },
            "shadows": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            },
            "s_curve": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            },
            "black_point": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            },
            "white_point": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            },
            "curve": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "points"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "legacy",
                    "custom"
                  ]
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2,
                    "items": false
                  },
                  "maxItems": 33
                },
                "channels": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "red": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "mode",
                        "points"
                      ],
                      "properties": {
                        "mode": {
                          "enum": [
                            "legacy",
                            "custom"
                          ]
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2,
                            "items": false
                          },
                          "maxItems": 33
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "mode": {
                                "const": "legacy"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "points": {
                                "maxItems": 0
                              }
                            }
                          },
                          "else": {
                            "properties": {
                              "points": {
                                "minItems": 2
                              }
                            }
                          }
                        }
                      ],
                      "default": {
                        "mode": "legacy",
                        "points": []
                      },
                      "description": "Custom PCHIP requires points in [0,1] with strictly increasing x and nondecreasing y (endpoints may move freely along x and y and clamp flat outside [x0, x_{n-1}]); these relational rules are validated by the core."
                    },
                    "green": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "mode",
                        "points"
                      ],
                      "properties": {
                        "mode": {
                          "enum": [
                            "legacy",
                            "custom"
                          ]
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2,
                            "items": false
                          },
                          "maxItems": 33
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "mode": {
                                "const": "legacy"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "points": {
                                "maxItems": 0
                              }
                            }
                          },
                          "else": {
                            "properties": {
                              "points": {
                                "minItems": 2
                              }
                            }
                          }
                        }
                      ],
                      "default": {
                        "mode": "legacy",
                        "points": []
                      },
                      "description": "Custom PCHIP requires points in [0,1] with strictly increasing x and nondecreasing y (endpoints may move freely along x and y and clamp flat outside [x0, x_{n-1}]); these relational rules are validated by the core."
                    },
                    "blue": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "mode",
                        "points"
                      ],
                      "properties": {
                        "mode": {
                          "enum": [
                            "legacy",
                            "custom"
                          ]
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2,
                            "items": false
                          },
                          "maxItems": 33
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "mode": {
                                "const": "legacy"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "points": {
                                "maxItems": 0
                              }
                            }
                          },
                          "else": {
                            "properties": {
                              "points": {
                                "minItems": 2
                              }
                            }
                          }
                        }
                      ],
                      "default": {
                        "mode": "legacy",
                        "points": []
                      },
                      "description": "Custom PCHIP requires points in [0,1] with strictly increasing x and nondecreasing y (endpoints may move freely along x and y and clamp flat outside [x0, x_{n-1}]); these relational rules are validated by the core."
                    }
                  }
                },
                "apply_to_luminosity": {
                  "type": "boolean",
                  "default": false
                },
                "parametric": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "highlights": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100,
                      "default": 0
                    },
                    "lights": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100,
                      "default": 0
                    },
                    "darks": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100,
                      "default": 0
                    },
                    "shadows": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100,
                      "default": 0
                    },
                    "split_shadow": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 0.45,
                      "default": 0.25
                    },
                    "split_midtone": {
                      "type": "number",
                      "minimum": 0.25,
                      "maximum": 0.75,
                      "default": 0.5
                    },
                    "split_highlight": {
                      "type": "number",
                      "minimum": 0.55,
                      "maximum": 0.95,
                      "default": 0.75
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "legacy"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "points": {
                        "maxItems": 0
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "points": {
                        "minItems": 2
                      }
                    }
                  }
                }
              ],
              "default": {
                "mode": "legacy",
                "points": []
              },
              "description": "Custom PCHIP requires points in [0,1] with strictly increasing x and nondecreasing y (endpoints may move freely along x and y and clamp flat outside [x0, x_{n-1}]); these relational rules are validated by the core."
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "curve"
                ],
                "properties": {
                  "curve": {
                    "properties": {
                      "mode": {
                        "const": "custom"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "s_curve": {
                    "const": 0
                  }
                }
              }
            }
          ]
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sharpening": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            }
          }
        },
        "hsl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hue": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "default": [
                0,
                0,
                0,
                0,
                0,
                0,
                0,
                0
              ]
            },
            "saturation": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "default": [
                0,
                0,
                0,
                0,
                0,
                0,
                0,
                0
              ]
            },
            "lightness": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "default": [
                0,
                0,
                0,
                0,
                0,
                0,
                0,
                0
              ]
            }
          }
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vignette_amount": {
              "type": "number",
              "minimum": -100,
              "maximum": 100,
              "default": 0
            },
            "vignette_midpoint": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 50
            },
            "vignette_roundness": {
              "type": "number",
              "minimum": -100,
              "maximum": 100,
              "default": 0
            },
            "vignette_feather": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 50
            },
            "vignette_highlights": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 0
            },
            "grain_amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 0
            },
            "grain_size": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 25
            },
            "grain_roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 50
            },
            "clarity": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            },
            "dehaze": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            }
          }
        },
        "denoise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raw_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            },
            "chroma_mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            },
            "wavelet": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "luma": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "default": 0
                },
                "chroma": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "default": 46
                },
                "coarse": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "default": 50
                }
              }
            }
          }
        },
        "lens_correction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "distortion": {
              "type": "boolean",
              "default": false
            },
            "tca": {
              "type": "boolean",
              "default": false
            },
            "auto_crop": {
              "type": "boolean",
              "default": true
            },
            "profile_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "default": null
            },
            "vignetting": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vibrance": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0
            }
          }
        },
        "color_grading": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shadows": {
              "$ref": "#/$defs/gradingWheel"
            },
            "midtones": {
              "$ref": "#/$defs/gradingWheel"
            },
            "highlights": {
              "$ref": "#/$defs/gradingWheel"
            },
            "global": {
              "$ref": "#/$defs/gradingWheel"
            },
            "blending": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 50
            },
            "balance": {
              "type": "number",
              "minimum": -100,
              "maximum": 100,
              "default": 0
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "jpeg",
            "png",
            "dng"
          ]
        },
        "jpeg_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 95
        },
        "size": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "native"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "long_edge"
              ],
              "properties": {
                "mode": {
                  "const": "limit_long_edge"
                },
                "long_edge": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              }
            }
          ]
        },
        "output_sharpening": {
          "enum": [
            "off",
            "low",
            "standard",
            "high"
          ],
          "default": "off"
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version",
        "quality"
      ],
      "properties": {
        "family": {
          "const": "rawlab"
        },
        "version": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "quality": {
          "const": "standard"
        }
      }
    },
    "x3f_mode": {
      "enum": [
        "legacy",
        "normal-v1"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "raster"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "edits": {
            "properties": {
              "exposure": {
                "properties": {
                  "mode": {
                    "const": "sensor"
                  }
                }
              },
              "white_balance": {
                "properties": {
                  "mode": {
                    "enum": [
                      "none",
                      "relative"
                    ]
                  }
                }
              },
              "denoise": {
                "properties": {
                  "raw_level": {
                    "const": 0
                  }
                }
              },
              "lens_correction": {
                "properties": {
                  "distortion": {
                    "const": false
                  },
                  "tca": {
                    "const": false
                  },
                  "profile_id": {
                    "const": null
                  },
                  "vignetting": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        "not": {
          "required": [
            "x3f_mode"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "type"
                  ]
                }
              },
              {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "raw"
                  }
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "edits": {
            "properties": {
              "white_balance": {
                "properties": {
                  "mode": {
                    "enum": [
                      "camera",
                      "auto",
                      "temperature"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "gradingWheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hue",
        "saturation"
      ],
      "properties": {
        "hue": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "default": 0
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "luminance": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        }
      }
    }
  }
}
