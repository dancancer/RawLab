{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawLab edit recipe v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input",
    "edits",
    "output"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure"
      ],
      "properties": {
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "scene",
                "preview",
                "sensor"
              ]
            },
            "ev": {
              "type": "number",
              "minimum": -20,
              "maximum": 20,
              "default": 0
            },
            "brightness": {
              "type": "number",
              "minimum": 1.1754943508222875e-38,
              "maximum": 3.4028234663852886e+38,
              "default": 1
            }
          }
        },
        "white_balance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "camera",
                "auto",
                "temperature"
              ]
            },
            "temperature_kelvin": {
              "type": "number",
              "minimum": 2000,
              "maximum": 50000
            },
            "tint": {
              "type": "number",
              "minimum": -150,
              "maximum": 150,
              "default": 0
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "temperature"
              }
            }
          },
          "then": {
            "required": [
              "temperature_kelvin"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "temperature_kelvin"
                  ]
                },
                {
                  "required": [
                    "tint"
                  ]
                }
              ]
            }
          }
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "default": null
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "crop": {
              "type": "object",
              "additionalProperties": false,
              "description": "Normalized rectangle after turns, flips and straightening; runtime also checks x+width and y+height <=1 with float boundary tolerance.",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1,
                  "default": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1,
                  "default": 0
                },
                "width": {
                  "type": "number",
                  "minimum": 1.1754943508222875e-38,
                  "maximum": 1,
                  "default": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 1.1754943508222875e-38,
                  "maximum": 1,
                  "default": 1
                }
              }
            },
            "quarter_turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "default": 0
            },
            "flip_horizontal": {
              "type": "boolean",
              "default": false
            },
            "flip_vertical": {
              "type": "boolean",
              "default": false
            },
            "straighten_degrees": {
              "type": "number",
              "minimum": -45,
              "maximum": 45,
              "default": 0
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "jpeg",
            "png",
            "dng"
          ]
        },
        "jpeg_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 95
        },
        "size": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "native"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "long_edge"
              ],
              "properties": {
                "mode": {
                  "const": "limit_long_edge"
                },
                "long_edge": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              }
            }
          ]
        }
      }
    }
  }
}
