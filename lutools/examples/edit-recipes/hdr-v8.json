{
  "schema_version": 8,
  "processing": {
    "family": "rawlab_hdr",
    "version": 2,
    "quality": "standard"
  },
  "input": {
    "path": "phone.heic",
    "type": "hdr_raster"
  },
  "edits": {
    "exposure": {
      "ev": 1
    },
    "white_balance": {
      "mode": "relative",
      "relative_temperature": 6500,
      "relative_tint": 0
    },
    "tone": {
      "contrast": 1,
      "saturation": 1,
      "highlights": 0,
      "shadows": 0,
      "black_point": -0.25,
      "white_point": 0.5,
      "curve": {
        "mode": "custom",
        "points": [
          [
            0,
            0
          ],
          [
            0.5,
            0.625
          ],
          [
            1,
            1
          ]
        ]
      }
    }
  },
  "output": {
    "path": "edited-hdr.jpg",
    "format": "hdr_jpeg",
    "base_color": "display_p3",
    "jpeg_quality": 95,
    "size": {
      "mode": "native"
    }
  }
}
