# 只有完整下载且校验通过的归档才进入可复用路径。
function(rawlab_download_archive url sha256 archive)
    get_filename_component(directory "${archive}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    set(partial "${archive}.part")
    file(REMOVE "${partial}")
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" existing_hash)
        if(existing_hash STREQUAL sha256)
            return()
        endif()
        file(REMOVE "${archive}")
    endif()

    foreach(attempt RANGE 1 3)
        file(DOWNLOAD "${url}" "${partial}" STATUS download_status
            TIMEOUT 120 INACTIVITY_TIMEOUT 30 TLS_VERIFY ON)
        list(GET download_status 0 download_code)
        list(GET download_status 1 reason)
        if(download_code EQUAL 0)
            file(SHA256 "${partial}" downloaded_hash)
            if(downloaded_hash STREQUAL sha256)
                file(RENAME "${partial}" "${archive}")
                return()
            endif()
            set(reason "SHA256 mismatch: expected ${sha256}, got ${downloaded_hash}")
        endif()
        file(REMOVE "${partial}")
        if(attempt LESS 3)
            message(STATUS "Archive download attempt ${attempt} failed: ${reason}; retrying ${url}")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep "${attempt}")
        endif()
    endforeach()
    message(FATAL_ERROR "Archive download failed after 3 attempts: ${url}\n${reason}")
endfunction()
