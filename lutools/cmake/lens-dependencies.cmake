enable_language(C)
find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
if(IOS)
    set(lens_platform ios)
    set(lens_arch "${CMAKE_OSX_ARCHITECTURES}")
    set(lens_minimum "${CMAKE_OSX_DEPLOYMENT_TARGET}")
elseif(ANDROID)
    set(lens_platform android)
    set(lens_arch "${ANDROID_ABI}")
    string(REGEX REPLACE "^android-" "" lens_minimum "${ANDROID_PLATFORM}")
elseif(WIN32)
    set(lens_platform windows)
    set(lens_arch x86_64)
    set(lens_minimum 10)
else()
    message(FATAL_ERROR "Source-built Lensfun is configured for iOS, Android or Windows; use pkg-config on desktop Unix")
endif()
set(lens_build "${CMAKE_BINARY_DIR}/lens-dependencies")
set(lens_args --build "${lens_build}" --platform "${lens_platform}" --arch "${lens_arch}"
    --cc "${CMAKE_C_COMPILER}" --cxx "${CMAKE_CXX_COMPILER}" --ar "${CMAKE_AR}"
    --cmake "${CMAKE_COMMAND}" --minimum "${lens_minimum}")
if(CMAKE_OSX_SYSROOT)
    list(APPEND lens_args --sysroot "${CMAKE_OSX_SYSROOT}")
endif()
if(ANDROID)
    list(APPEND lens_args --toolchain "${CMAKE_TOOLCHAIN_FILE}")
endif()
set(RAWLAB_LENS_SOURCE_CACHE "$ENV{RAWLAB_LENS_SOURCE_CACHE}" CACHE PATH "Optional cache of checksum-verified Lensfun/GLib source archives")
if(RAWLAB_LENS_SOURCE_CACHE)
    list(APPEND lens_args --source-cache "${RAWLAB_LENS_SOURCE_CACHE}")
endif()
if(NOT "$ENV{RAWLAB_CI_CACHE_HIT}" STREQUAL "true")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/build-lens-dependencies.py" ${lens_args}
        RESULT_VARIABLE lens_result)
    if(NOT lens_result EQUAL 0)
        message(FATAL_ERROR "Target Lensfun/GLib dependency build failed (${lens_result})")
    endif()
endif()
set(lens_prefix "${lens_build}/install")
file(READ "${lens_prefix}/libraries.json" lens_libraries)
if(NOT EXISTS "${lens_prefix}/include/lensfun/lensfun.h")
    message(FATAL_ERROR "Missing Lensfun dependency headers: ${lens_prefix}")
endif()
string(JSON lens_library_count LENGTH "${lens_libraries}")
math(EXPR lens_library_last "${lens_library_count} - 1")
foreach(index RANGE ${lens_library_last})
    string(JSON name MEMBER "${lens_libraries}" ${index})
    string(JSON library GET "${lens_libraries}" "${name}")
    if(NOT EXISTS "${library}")
        message(FATAL_ERROR "Missing Lensfun dependency: ${library}")
    endif()
endforeach()
add_library(rawlab_lensfun INTERFACE)
target_include_directories(rawlab_lensfun INTERFACE "${lens_prefix}/include/lensfun")
target_compile_definitions(rawlab_lensfun INTERFACE CONF_LENSFUN_STATIC)
foreach(name lensfun glib-2.0 pcre2-8 intl)
    string(JSON library GET "${lens_libraries}" "${name}")
    target_link_libraries(rawlab_lensfun INTERFACE "${library}")
endforeach()
if(IOS)
    target_link_libraries(rawlab_lensfun INTERFACE iconv)
elseif(ANDROID)
    foreach(name iconv charset)
        string(JSON library GET "${lens_libraries}" "${name}")
        target_link_libraries(rawlab_lensfun INTERFACE "${library}")
    endforeach()
    target_link_libraries(rawlab_lensfun INTERFACE m)
elseif(WIN32)
    string(JSON library GET "${lens_libraries}" "regex")
    target_link_libraries(rawlab_lensfun INTERFACE "${library}")
    target_link_libraries(rawlab_lensfun INTERFACE ws2_32 ole32 winmm shlwapi uuid)
endif()
file(COPY "${lens_prefix}/licenses/" DESTINATION "${CMAKE_BINARY_DIR}/licenses")
set(LENSFUN_LIBRARY rawlab_lensfun)
set(LENSFUN_FOUND TRUE)
