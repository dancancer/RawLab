<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="denoise/**/*.cs" />
    <Compile Remove="updates/**/*.cs" />
    <Compile Remove="editing/**/*.cs" />
    <Compile Remove="looks/**/*.cs" />
    <Compile Remove="localization/**/*.cs" />
    <Compile Remove="localization-ui/**/*.cs" />
    <Compile Remove="ui-automation/**/*.cs" />
    <Compile Remove="usage/**/*.cs" />
    <!-- 测试永远不带统计 SDK：只用不可用或假的 transport，不可能发出正式数据 -->
    <ProjectReference Include="../RawLabWindows.csproj" AdditionalProperties="RawLabRumSdk=false" />
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.EnableHardwareAccelerationInRdp" Value="true" />
  </ItemGroup>
</Project>
