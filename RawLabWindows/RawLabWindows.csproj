<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>RawLab.Windows.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RawLab</AssemblyName>
    <Version>0.9.1</Version>
    <FileVersion>0.9.1.16</FileVersion>
    <InformationalVersion>0.9.1+build.16</InformationalVersion>
    <RawLabUpdateTrustFile Condition="'$(RawLabUpdateTrustFile)' == ''">$(MSBuildThisFileDirectory)Updates/UpdateTrust.json</RawLabUpdateTrustFile>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <!-- 阿里云 RUM PC SDK（使用统计）：Release 默认带，规则与开关见 RumSdk.targets -->
  <Import Project="RumSdk.targets" />
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <EmbeddedResource Include="$(RawLabUpdateTrustFile)" LogicalName="RawLab.UpdateTrust.json" />
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.EnableHardwareAccelerationInRdp" Value="true" />
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="Resources/Localization/*.json" />
    <Content Include="../lutools/flog-2-new/*.cube" Exclude="../lutools/flog-2-new/*FLog2-709*;../lutools/flog-2-new/*WDR*" Link="LUTs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../RawLabMac/Resources/FilmIcons/*.png" Link="FilmIcons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Shared/BundledLooks/*.cube" Link="LUTs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Shared/BundledLooks/catalog.json" Link="bundled-looks.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Shared/BundledLooks/Artwork/*.png" Link="FilmIcons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Shared/BundledLooks/NOTICE.md" Link="Licenses/Bundled-Looks.md" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../RawLabMac/Resources/AppIcon.png" Link="AppIcon.png" />
    <Content Include="../Shared/master-recipes.json" Link="master-recipes.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../lutools/third_party/lensfun/version_1/*.xml" Link="Lensfun/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../RawLabMac/Resources/MasterRecipes/*.cube" Link="MasterRecipes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../RawLabMac/Resources/MasterRecipeIcons/*.png" Link="MasterRecipeIcons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
