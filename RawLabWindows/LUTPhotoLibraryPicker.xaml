<Window x:Class="RawLab.Windows.LUTPhotoLibraryPicker" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RawLab.Windows"
    Style="{StaticResource {x:Type Window}}" Width="680" Height="620" MinWidth="480" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.AutomationId="look.compatibility.library">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="{DynamicResource '从照片库选择'}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="Notice" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
    <TreeView x:Name="Photos" Grid.Row="1" Background="Transparent" BorderThickness="0"
        TreeViewItem.Expanded="FolderExpanded" SelectedItemChanged="PhotoSelected"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
        ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:LibraryEntry}" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Margin="0,4" ToolTip="{Binding Path}">
            <Grid Width="96" Height="72" Margin="0,0,12,0">
              <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
              <Border Background="{DynamicResource InputSurface}" CornerRadius="3"><local:EditorIcon Kind="Photo" Width="24" Height="24" TextElement.Foreground="{DynamicResource Muted}"/></Border>
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded"/>
            </Grid>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.Resources>
    </TreeView>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{DynamicResource '取消'}" IsCancel="True" MinWidth="80" Margin="0,0,12,0"/>
      <Button x:Name="Confirm" Content="{DynamicResource '使用此照片'}" IsDefault="True" IsEnabled="False" MinWidth="110"
          Click="ConfirmClicked" AutomationProperties.AutomationId="look.compatibility.library.confirm"/>
    </StackPanel>
  </Grid>
</Window>
