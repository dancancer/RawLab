<Window x:Class="RawLab.Windows.BatchExportWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:RawLab.Windows" Style="{StaticResource {x:Type Window}}" Title="{DynamicResource 'RawLab · 批量导出'}" Width="1040" Height="760" MinWidth="900" MinHeight="620">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="22,20,22,14">
      <DockPanel>
        <StackPanel x:Name="SelectionActions" DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Click="AddClicked" ToolTip="{DynamicResource '添加照片'}" AutomationProperties.Name="{DynamicResource '添加 RAW'}"><local:EditorIcon Kind="Add" Width="20" Height="20"/></Button>
          <Button Content="{DynamicResource '全选'}" Click="SelectAllClicked"/><Button Content="{DynamicResource '全不选'}" Click="SelectNoneClicked"/>
        </StackPanel>
        <TextBlock x:Name="Heading" Text="{DynamicResource '批量导出'}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="Summary" Foreground="{DynamicResource Muted}" Margin="0,8,0,10" AutomationProperties.LiveSetting="Polite"/>
      <ProgressBar x:Name="Progress" Height="4" Foreground="{DynamicResource Indicator}" Background="{DynamicResource ProgressSurface}" Visibility="Collapsed"/>
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForeground}" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Grid Margin="14,0,0,0">
        <ListBox x:Name="Targets" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Foreground}" HorizontalContentAlignment="Stretch"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent"><ContentPresenter HorizontalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Padding="8,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" IsEnabled="{Binding Selectable}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Name}"/>
                <Button Grid.Column="1" Click="InspectClicked" Style="{StaticResource QuietButton}" Padding="0" Width="78" Height="68" ToolTip="{DynamicResource '查看应用后的效果'}" IsEnabled="{Binding CanInspect}">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" AutomationProperties.Name="{Binding Name}"/>
                </Button>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Input}"/>
                  <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorForeground}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <Button Content="{DynamicResource '移除'}" Click="RemoveClicked" Style="{StaticResource QuietButton}" Visibility="{Binding EditVisibility}"/>
                  <Button Click="RevealClicked" Style="{StaticResource QuietButton}" Visibility="{Binding OutputVisibility}" ToolTip="{DynamicResource '显示成片'}" AutomationProperties.Name="{DynamicResource '显示成片'}"><local:EditorIcon Kind="Folder" Width="20" Height="20"/></Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
          <local:EditorIcon Kind="Photo" Width="40" Height="40" HorizontalAlignment="Center"/>
          <TextBlock Text="{DynamicResource '尚未选择 RAW'}" Margin="0,16" HorizontalAlignment="Center"/>
          <Button Content="{DynamicResource '选择照片…'}" Click="AddClicked"/>
        </StackPanel>
      </Grid>
      <Border Grid.Column="1" BorderBrush="{DynamicResource Outline}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,10,22,20">
            <TextBlock Text="{DynamicResource '调整来源'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Image x:Name="SourceThumbnail" Height="78" Stretch="Uniform"/>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SourceName" TextWrapping="Wrap"/><TextBlock x:Name="SourceLook" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
            </Grid>
            <TextBlock x:Name="SourceSummary" Margin="0,20,0,14" LineHeight="28" TextWrapping="Wrap"/>
            <Expander Header="{DynamicResource '全部调整'}" Foreground="{DynamicResource Foreground}"><TextBlock x:Name="AllSettings" Margin="0,12,0,0" LineHeight="24" TextWrapping="Wrap"/></Expander>
            <Separator Margin="0,24,0,18"/>
            <TextBlock Text="{DynamicResource '输出'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <WrapPanel x:Name="FormatOptions" Margin="0,0,0,20">
              <RadioButton x:Name="Jpeg" Content="JPEG" GroupName="Format" Checked="FormatChanged" Margin="0,0,24,0" Foreground="{DynamicResource Foreground}"/>
              <RadioButton x:Name="Png" Content="16-bit PNG" GroupName="Format" Checked="FormatChanged" Margin="0,0,24,0" Foreground="{DynamicResource Foreground}"/>
              <RadioButton x:Name="Dng" Content="{DynamicResource 'DNG · 渲染型'}" AutomationProperties.Name="{DynamicResource 'DNG · 渲染型'}" GroupName="Format" Checked="FormatChanged" Foreground="{DynamicResource Foreground}"/>
            </WrapPanel>
            <StackPanel Margin="0,0,0,18">
              <TextBlock Text="{DynamicResource '尺寸'}"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ComboBox x:Name="SizeSelection" Width="150" SelectionChanged="ExportSizeChanged" AutomationProperties.Name="{DynamicResource '导出尺寸'}">
                  <ComboBoxItem Content="{DynamicResource '原尺寸'}" Tag="original"/><ComboBoxItem Content="{DynamicResource '长边 2048 px'}" Tag="2048"/><ComboBoxItem Content="{DynamicResource '长边 3000 px'}" Tag="3000"/><ComboBoxItem Content="{DynamicResource '长边 4096 px'}" Tag="4096"/><ComboBoxItem Content="{DynamicResource '自定义'}" Tag="custom"/>
                </ComboBox>
                <TextBox x:Name="CustomLongEdge" Width="82" Margin="8,0,0,0" Visibility="Collapsed" TextChanged="CustomSizeTextChanged" LostKeyboardFocus="CustomSizeCommitted" KeyDown="CustomSizeKeyDown" AutomationProperties.Name="{DynamicResource '自定义长边'}"/>
                <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding Visibility, ElementName=CustomLongEdge}"/>
              </StackPanel>
              <TextBlock x:Name="SizeError" Foreground="{DynamicResource ErrorForeground}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <DockPanel Margin="0,0,0,18">
              <Button x:Name="ChooseFolder" Click="FolderClicked" DockPanel.Dock="Right" ToolTip="{DynamicResource '选择输出文件夹'}" AutomationProperties.Name="{DynamicResource '选择输出文件夹'}"><local:EditorIcon Kind="Folder" Width="20" Height="20"/></Button>
              <TextBlock Text="{DynamicResource '保存到'}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock x:Name="Destination" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <DockPanel><TextBlock Text="{DynamicResource '自动添加序号'}" Foreground="{DynamicResource Muted}" DockPanel.Dock="Right"/><TextBlock Text="{DynamicResource '重名文件'}"/></DockPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="18,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="CloseAction" Content="{DynamicResource '取消'}" Click="CloseClicked"/>
          <Button x:Name="RevealFolder" Content="{DynamicResource '打开文件夹'}" Click="RevealFolderClicked" Visibility="Collapsed"/>
          <Button x:Name="PrimaryAction" Content="{DynamicResource '导出 0 张'}" Click="PrimaryClicked" Style="{StaticResource AccentButton}" FontWeight="SemiBold" MinWidth="125"/>
        </StackPanel>
        <TextBlock x:Name="Footnote" Text="{DynamicResource '仅用于本次导出，保留各照片原有调整'}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
