<Window x:Class="RawLab.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RawLab.Windows"
    Title="RawLab · Windows" Style="{StaticResource {x:Type Window}}" Width="1440" Height="920" MinWidth="1000" MinHeight="680" Icon="AppIcon.png" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="KeyPressed">

  <Window.Resources>
    <Style x:Key="WorkspaceModeButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>
    <Style x:Key="WorkspacePhotoList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Photos}" Height="{Binding RowHeight}" KeyboardNavigation.DirectionalNavigation="Contained">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="PhotoSelected" PreviewMouseLeftButtonDown="PhotoTilePressed" PreviewMouseRightButtonDown="PhotoTileContextPressed" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.ItemStatus="{Binding PhotoStatus}" Margin="2" Padding="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Tag" Value="selected"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                      <ContextMenu Opened="PhotoContextMenuOpened">
                        <MenuItem Header="{DynamicResource '打开照片'}" Click="OpenLibraryPhotoClicked"/>
                        <MenuItem Header="{DynamicResource '在资源管理器中打开'}" Click="OpenInExplorerClicked"/>
                        <MenuItem Header="{DynamicResource '应用当前设置'}" Click="ApplyCurrentSettingsClicked"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Border Background="{DynamicResource InputSurface}" CornerRadius="3">
                        <local:EditorIcon Kind="Photo" Width="22" Height="22" TextElement.Foreground="{DynamicResource Muted}"/>
                      </Border>
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded"/>
                      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Padding="5,1" Background="{DynamicResource Accent}" CornerRadius="3" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMarked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="✓" Foreground="{DynamicResource AccentText}"/>
                      </Border>
                      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4" Background="#B8000000" CornerRadius="3" IsHitTestVisible="False" ToolTip="{DynamicResource '已编辑'}">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEdited}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <local:EditorIcon Kind="Pencil" Width="13" Height="13" TextElement.Foreground="White"/>
                      </Border>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" Padding="3" Background="#B8000000" CornerRadius="3" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PreviewNotice}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding PreviewNotice}" Foreground="White" FontSize="9"/>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource EditorCaptionSize}" TextAlignment="Center" Margin="1,4,1,1"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid TextElement.Foreground="{DynamicResource Foreground}" Background="{DynamicResource CanvasSurface}">
  <Grid x:Name="EditorShell">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Menu x:Name="MainMenu" MinHeight="28" Background="{DynamicResource RaisedSurface}" Padding="8,0" FocusManager.IsFocusScope="True">
      <MenuItem Header="{DynamicResource '文件(_F)'}">
        <MenuItem Header="{DynamicResource '打开 RAW'}" InputGestureText="Ctrl+O" Click="OpenClicked"/>
        <MenuItem Header="{DynamicResource '添加目录'}" Click="AddFolderClicked"/>
        <MenuItem x:Name="MenuImportLook" Header="{DynamicResource '导入外观'}" Click="ImportClicked"/>
        <Separator/><MenuItem x:Name="MenuExport" Header="{DynamicResource '导出'}" Click="MainExportClicked" IsEnabled="False"/>
        <MenuItem x:Name="MenuCollection" Header="{DynamicResource '批量编辑'}" Click="OpenCollectionClicked" AutomationProperties.AutomationId="collection.open"/>
        <MenuItem x:Name="MenuBatch" Header="{DynamicResource '使用当前调整批量导出…'}" Click="BatchExportClicked" IsEnabled="False"/>
        <MenuItem x:Name="MenuViewBatch" Header="{DynamicResource '查看批量任务…'}" Click="ShowBatchClicked" IsEnabled="False"/>
        <Separator/><MenuItem Header="{DynamicResource '退出'}" Click="ExitClicked"/>
      </MenuItem>
      <MenuItem Header="{DynamicResource '编辑(_E)'}" SubmenuOpened="EditMenuOpened" AutomationProperties.AutomationId="adjustment.edit-menu">
        <MenuItem x:Name="UndoAdjustmentMenu" Header="{DynamicResource '撤销'}" InputGestureText="Ctrl+Z" Click="UndoAdjustmentClicked" AutomationProperties.AutomationId="adjustment.undo"/>
        <MenuItem x:Name="RedoAdjustmentMenu" Header="{DynamicResource '重做'}" InputGestureText="Ctrl+Y" Click="RedoAdjustmentClicked" AutomationProperties.AutomationId="adjustment.redo"/>
        <Separator/>
        <MenuItem x:Name="CopyAdjustmentMenu" Header="{DynamicResource '复制调整…'}" InputGestureText="Ctrl+Shift+C" Click="CopyAdjustmentsClicked" AutomationProperties.AutomationId="adjustment.copy.open"/>
        <MenuItem x:Name="PasteAdjustmentMenu" Header="{DynamicResource '粘贴调整…'}" InputGestureText="Ctrl+Shift+V" Click="PasteAdjustmentsClicked" AutomationProperties.AutomationId="adjustment.paste.open"/>
        <MenuItem x:Name="PastePhotosAdjustmentMenu" Header="{DynamicResource '粘贴到所选照片…'}" Click="PasteAdjustmentsToPhotosClicked" AutomationProperties.AutomationId="adjustment.paste.photos"/>
        <MenuItem x:Name="HistoryAdjustmentMenu" Header="{DynamicResource '本次会话历史…'}" Click="ShowAdjustmentHistoryClicked" AutomationProperties.AutomationId="adjustment.history.open"/>
        <MenuItem x:Name="PresetsAdjustmentMenu" Header="{DynamicResource '我的预设'}" Click="ShowPresetsClicked" AutomationProperties.AutomationId="preset.library.open"/>
        <Separator/>
        <!-- 打开编辑菜单时按当前工具重建，与调整栏的重置菜单同源。 -->
      </MenuItem>
      <MenuItem Header="{DynamicResource '查看(_V)'}">
        <MenuItem x:Name="HDREditMenu" Header="{DynamicResource 'HDR 编辑'}" IsCheckable="True" Click="HDREditClicked" AutomationProperties.AutomationId="hdr.editing"/>
        <MenuItem x:Name="HDRPreviewMenu" Header="{DynamicResource '自动 HDR'}" IsCheckable="True" IsChecked="True" Click="HDRPreviewClicked" AutomationProperties.AutomationId="hdr.preview.auto"/>
        <MenuItem x:Name="HDRSdrPreviewMenu" Header="{DynamicResource 'SDR 兼容预览'}" IsCheckable="True" Click="HDRSdrPreviewClicked" AutomationProperties.AutomationId="hdr.preview.sdr"/>
        <MenuItem x:Name="HDRFalseColorMenu" Header="{DynamicResource 'HDR 假色'}" IsCheckable="True" Click="HDRFalseColorClicked" AutomationProperties.AutomationId="hdr.false-color"/>
        <MenuItem x:Name="HDRRenditionMenu" Header="{DynamicResource 'HDR 输出与 SDR 底图'}" Click="HDRRenditionClicked" AutomationProperties.AutomationId="hdr.rendition.open"/>
        <MenuItem x:Name="HDRLookMenu" Header="HDR LUT…" Click="HDRLookClicked" AutomationProperties.AutomationId="hdr.look.open"/>
        <MenuItem x:Name="HDRCameraMenu" Header="HDR RAW…" Click="HDRCameraClicked" AutomationProperties.AutomationId="hdr.camera.open"/>
        <Separator/>
        <MenuItem Header="{DynamicResource '文件树'}" Click="LibraryToggle"/>
        <MenuItem Header="{DynamicResource '调整栏'}" Click="DockToggle"/>
        <MenuItem Header="{DynamicResource '直方图'}" Click="HistogramClicked"/>
        <MenuItem Header="{DynamicResource '照片信息'}" InputGestureText="I" Click="InfoClicked"/>
        <MenuItem x:Name="BeforeViewMenu" Header="{DynamicResource '查看调整前'}" IsCheckable="True" Click="BeforeViewClicked"/>
        <MenuItem x:Name="MenuPhotoMargin" Header="{DynamicResource '照片四周留白'}" IsCheckable="True" IsChecked="True" Click="PhotoMarginClicked"/>
        <MenuItem Header="{DynamicResource '显示裁切提示'}" Click="ClippingClicked"/>
        <Separator/><MenuItem Header="{DynamicResource '对比方式'}"><MenuItem x:Name="MenuCompareOff" Header="{DynamicResource '关闭对比'}" IsCheckable="True" Click="CompareOffClicked"/><MenuItem x:Name="MenuCompareSide" Header="{DynamicResource '并排'}" IsCheckable="True" Click="CompareSideClicked"/><MenuItem x:Name="MenuCompareSwipe" Header="{DynamicResource '分割线'}" IsCheckable="True" Click="CompareSwipeClicked"/></MenuItem>
        <MenuItem Header="{DynamicResource '缩放'}"><MenuItem Header="{DynamicResource '适合窗口'}" InputGestureText="F" Click="FitClicked"/><MenuItem Header="{DynamicResource '实际像素 · 100%'}" InputGestureText="1" Click="ActualClicked"/><MenuItem Header="{DynamicResource '放大'}" Click="ZoomInClicked"/><MenuItem Header="{DynamicResource '缩小'}" Click="ZoomOutClicked"/></MenuItem>
      </MenuItem>
      <MenuItem x:Name="ToolsMenu" Header="{DynamicResource '工具(_T)'}"><MenuItem x:Name="MenuAutoExposure" Header="{DynamicResource '自动调整曝光'}" Click="AutoExposureClicked" IsEnabled="False"/><MenuItem x:Name="MenuAsShot" Header="{DynamicResource '拍摄时白平衡'}" Click="AsShotClicked" IsEnabled="False"/><Separator/><MenuItem Header="{DynamicResource '设置'}" Click="SettingsClicked"/></MenuItem>
      <MenuItem Header="{DynamicResource '帮助(_H)'}"><MenuItem Header="{DynamicResource '关于 RawLab'}" Click="AboutClicked"/></MenuItem>
    </Menu>
    <Border Grid.Row="1" MinHeight="48" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,2">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="OpenPhoto" AutomationProperties.AutomationId="OpenPhoto" Click="OpenClicked" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '打开 RAW（Ctrl+O）'}" AutomationProperties.Name="{DynamicResource '打开 RAW'}"><local:EditorIcon Kind="Folder" Width="22" Height="22"/></Button>
          <Button x:Name="LibraryToggleButton" Click="LibraryToggle" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '显示或收起文件树'}" AutomationProperties.Name="{DynamicResource '文件树'}" AutomationProperties.AutomationId="workspace.library.toggle"><local:EditorIcon Kind="Library" Width="22" Height="22"/></Button>
        </StackPanel>
        <Button x:Name="UpdateNotice" MaxWidth="140" Click="SoftwareUpdatesClicked" PreviewMouseDown="UpdateNavigationPressed" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource QuietButton}" ToolTip="{DynamicResource '查看更新'}"/>
        <Button x:Name="ExportButton" Click="ExportMenuClicked" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" IsEnabled="False" ToolTip="{DynamicResource '导出'}" AutomationProperties.Name="{DynamicResource '导出'}">
          <local:EditorIcon Kind="Export" Width="22" Height="22"/>
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="{DynamicResource '导出尺寸'}"><MenuItem x:Name="ExportOriginalSize" Header="{DynamicResource '原尺寸'}" IsCheckable="True" Click="ExportOriginalSizeClicked"/><MenuItem x:Name="ExportSize2048" Header="{DynamicResource '长边 2048 px'}" IsCheckable="True" Click="ExportSizeClicked" Tag="2048"/><MenuItem x:Name="ExportSize3000" Header="{DynamicResource '长边 3000 px'}" IsCheckable="True" Click="ExportSizeClicked" Tag="3000"/><MenuItem x:Name="ExportSize4096" Header="{DynamicResource '长边 4096 px'}" IsCheckable="True" Click="ExportSizeClicked" Tag="4096"/><MenuItem x:Name="ExportCustomSize" Header="{DynamicResource '自定义…'}" IsCheckable="True" Click="ExportCustomSizeClicked"/></MenuItem>
            <Separator/><MenuItem x:Name="ExportJpeg" ToolTip="{DynamicResource 'JPEG：质量 95，保留可读取拍摄信息。'}" Header="{DynamicResource 'JPEG…'}" Click="ExportJpegClicked" IsEnabled="False"/><MenuItem x:Name="ExportHdrJpeg" Header="{DynamicResource 'HDR JPEG'}" Click="ExportHdrJpegClicked" IsEnabled="False"/><MenuItem x:Name="ExportSdrJpeg" Header="{DynamicResource '保存 SDR JPEG'}" Click="ExportSdrJpegClicked" IsEnabled="False"/><MenuItem x:Name="ExportPng" ToolTip="{DynamicResource 'PNG：16-bit，保留可读取拍摄信息。'}" Header="{DynamicResource 'PNG · 16-bit…'}" Click="ExportPngClicked" IsEnabled="False"/><MenuItem x:Name="ExportDng" ToolTip="{DynamicResource 'DNG：渲染型成片，不含原始传感器数据或拍摄 EXIF。'}" Header="{DynamicResource '导出渲染型 DNG'}" Click="ExportDngClicked" IsEnabled="False"/><Separator/><MenuItem x:Name="BatchExportMenu" Header="{DynamicResource '使用当前调整批量导出…'}" Click="BatchExportClicked" IsEnabled="False"/><MenuItem x:Name="ViewBatchMenu" Header="{DynamicResource '查看批量任务…'}" Click="ShowBatchClicked" IsEnabled="False"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="HistogramButton" Click="HistogramClicked" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource '直方图'}" AutomationProperties.AutomationId="workspace.histogram.toggle"><local:EditorIcon Kind="Histogram" Width="22" Height="22"/></Button>
          <Button x:Name="CompareButton" Click="CompareClicked" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '对比模式：并排 / 滑动'}" AutomationProperties.Name="{DynamicResource '对比模式'}">
            <local:EditorIcon Kind="Compare" Width="22" Height="22"/>
            <Button.ContextMenu><ContextMenu><MenuItem x:Name="CompareOff" Header="{DynamicResource '关闭对比'}" IsCheckable="True" IsChecked="True" Click="CompareOffClicked"/><MenuItem x:Name="CompareSide" Header="{DynamicResource '并排'}" IsCheckable="True" Click="CompareSideClicked"/><MenuItem x:Name="CompareSwipe" Header="{DynamicResource '分割线'}" IsCheckable="True" Click="CompareSwipeClicked"/></ContextMenu></Button.ContextMenu>
          </Button>
          <Button x:Name="CompareModeButton" Click="CompareModeClicked" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '对比方式'}" AutomationProperties.Name="{DynamicResource '对比方式'}"><local:EditorIcon Kind="ChevronDown" Width="14" Height="14"/></Button>
          <Button x:Name="ZoomButton" Click="ZoomClicked" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '缩放与显示'}" AutomationProperties.Name="{DynamicResource '缩放与显示'}"><local:EditorIcon Kind="Zoom" Width="22" Height="22"/><Button.ContextMenu><ContextMenu><MenuItem x:Name="ZoomPhotoMargin" Header="{DynamicResource '照片四周留白'}" IsCheckable="True" IsChecked="True" Click="PhotoMarginClicked"/><Separator/><MenuItem Header="{DynamicResource '适合窗口'}" InputGestureText="F" Click="FitClicked"/><MenuItem Header="{DynamicResource '实际像素 · 100%'}" InputGestureText="1" Click="ActualClicked"/><Separator/><MenuItem Header="{DynamicResource '放大'}" InputGestureText="+" Click="ZoomInClicked"/><MenuItem Header="{DynamicResource '缩小'}" InputGestureText="−" Click="ZoomOutClicked"/></ContextMenu></Button.ContextMenu></Button>
          <Button x:Name="ClippingButton" Click="ClippingClicked" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '显示输出高光与黑位裁切'}" AutomationProperties.Name="{DynamicResource '显示裁切提示'}"><local:EditorIcon Kind="Clipping" Width="22" Height="22"/></Button>
          <Button x:Name="CollectionReturn" Click="OpenCollectionClicked" Visibility="Collapsed" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '返回批量集合'}" AutomationProperties.Name="{DynamicResource '返回批量集合'}" AutomationProperties.AutomationId="collection.return"><local:EditorIcon Kind="Collection" Width="22" Height="22"/></Button>
          <Button x:Name="InfoButton" Click="InfoClicked" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '照片信息：隐藏 / 文件信息 / 拍摄参数（I）'}" AutomationProperties.Name="{DynamicResource '照片信息'}"><local:EditorIcon Kind="Info" Width="22" Height="22"/></Button>
          <Button x:Name="AdjustToggleButton" Click="DockToggle" Style="{StaticResource ToolbarButton}" ToolTip="{DynamicResource '展开调整栏'}" AutomationProperties.Name="{DynamicResource '调整栏'}" AutomationProperties.AutomationId="workspace.inspector.toggle"><local:EditorIcon Kind="Inspector" Width="22" Height="22"/></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Cycle">
          <Button x:Name="EditingWorkspaceButton" Click="WorkspaceModeClicked" Style="{StaticResource WorkspaceModeButton}" AutomationProperties.Name="{DynamicResource '编辑'}" AutomationProperties.AutomationId="workspace.mode.editing">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False"><local:EditorIcon Kind="Adjust" Width="16" Height="16"/><TextBlock Text="{DynamicResource '编辑'}" Margin="5,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="SelectionWorkspaceButton" Click="WorkspaceModeClicked" Style="{StaticResource WorkspaceModeButton}" AutomationProperties.Name="{DynamicResource '选片'}" AutomationProperties.AutomationId="workspace.mode.selection">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False"><local:EditorIcon Kind="ContactSheet" Width="16" Height="16"/><TextBlock Text="{DynamicResource '选片'}" Margin="5,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="PreviewWorkspaceButton" Click="WorkspaceModeClicked" Style="{StaticResource WorkspaceModeButton}" AutomationProperties.Name="{DynamicResource '纯预览'}" AutomationProperties.AutomationId="workspace.mode.preview">
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False"><local:EditorIcon Kind="Preview" Width="16" Height="16"/><TextBlock Text="{DynamicResource '纯预览'}" Margin="5,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" x:Name="WorkspaceBody">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LibraryColumn" Width="232" MaxWidth="288"/>
        <ColumnDefinition x:Name="LibrarySplitterColumn" Width="5"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="InspectorSplitterColumn" Width="0"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="0" MaxWidth="360"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="LibraryDock">
        <Border x:Name="LibraryPanel" Background="{DynamicResource TreeSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,1,0"
            AllowDrop="True" PreviewDragEnter="LibraryDragOver" PreviewDragOver="LibraryDragOver" PreviewDrop="LibraryDropped" AutomationProperties.AutomationId="workspace.library">
          <Grid x:Name="LibraryBody">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="FolderTreeRow" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="8,3">
              <Button x:Name="AddDirectoryButton" DockPanel.Dock="Right" Click="AddFolderClicked" Style="{StaticResource QuietButton}" Padding="6,3" ToolTip="{DynamicResource '添加目录'}" AutomationProperties.Name="{DynamicResource '添加目录'}" AutomationProperties.AutomationId="workspace.folders.add"><local:EditorIcon Kind="Add" Width="15" Height="15"/></Button>
              <Button x:Name="CollapseFoldersButton" DockPanel.Dock="Right" Click="CollapseFoldersClicked" Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="workspace.folders.collapseAll"><TextBlock Text="{DynamicResource '收起全部'}" TextWrapping="Wrap"/></Button>
              <TextBlock Text="{DynamicResource '文件夹'}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <TreeView x:Name="Files" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="3,0"
                      TreeViewItem.Expanded="FolderExpanded" SelectedItemChanged="FolderSelected" PreviewMouseRightButtonDown="FilesPreviewMouseRightButtonDown"
                      VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="workspace.folders.scroll">
              <TreeView.Resources>
                <Style x:Key="WorkspaceFolderItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                  <Style.Triggers><DataTrigger Binding="{Binding Path}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
                <HierarchicalDataTemplate ItemContainerStyle="{StaticResource WorkspaceFolderItem}" DataType="{x:Type local:LibraryEntry}" ItemsSource="{Binding Folders}">
                  <Button Click="BrowseFolderClicked" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" MinHeight="28" Padding="1" Margin="0" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                  <DockPanel IsHitTestVisible="False">
                    <local:EditorIcon Kind="Folder" Width="15" Height="15" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel></Button>
                </HierarchicalDataTemplate>
              </TreeView.Resources>
              <TreeView.ItemContainerStyle><StaticResource ResourceKey="WorkspaceFolderItem"/></TreeView.ItemContainerStyle>
              <TreeView.ContextMenu><ContextMenu x:Name="FileTreeContextMenu" Opened="FileTreeContextMenuOpened"><MenuItem x:Name="OpenTreeEntryMenu" Header="{DynamicResource '在资源管理器中打开'}" Click="OpenInExplorerClicked"/><MenuItem x:Name="ApplyTreeEntryMenu" Header="{DynamicResource '应用当前设置'}" Click="ApplyCurrentSettingsClicked"/><Separator/><MenuItem x:Name="RemoveRootMenu" Header="{DynamicResource '从列表移除根目录'}" Click="RemoveFolderClicked"/><MenuItem x:Name="RefreshRootMenu" Header="{DynamicResource '重新读取目录'}" Click="RefreshFolderClicked"/></ContextMenu></TreeView.ContextMenu>
            </TreeView>
            <Grid x:Name="SidebarPhotos" Grid.Row="2">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border x:Name="SidebarHeadingHost">
                <Border x:Name="BrowserHeading" Padding="10,6" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,1">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock x:Name="FolderPhotoCount" DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource EditorCaptionSize}" AutomationProperties.AutomationId="workspace.photos.count"/>
                      <TextBlock Text="{DynamicResource '照片'}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock x:Name="FolderBreadcrumb" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="workspace.photos.path"/>
                    <WrapPanel>
                      <Button x:Name="UpFolderButton" Content="{DynamicResource '上一级'}" Click="UpFolderClicked" Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="workspace.photos.up"/>
                      <Button x:Name="RevealFolderButton" Click="RevealFolderClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '在目录树中定位'}" AutomationProperties.Name="{DynamicResource '在目录树中定位'}" AutomationProperties.AutomationId="workspace.photos.revealFolder"><local:EditorIcon Kind="Library" Width="16" Height="16"/></Button>
                      <Button x:Name="RetryFolderButton" Content="{DynamicResource '重新读取目录'}" Click="RetryFolderClicked" Style="{StaticResource ToolButton}" Visibility="Collapsed"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Border>
              <ListBox x:Name="SidebarGallery" Grid.Row="1" Style="{StaticResource WorkspacePhotoList}" Margin="4" AutomationProperties.AutomationId="workspace.photos.scroll"/>
              <TextBlock x:Name="SidebarGalleryNotice" Grid.Row="1" Margin="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" IsHitTestVisible="False"/>
            </Grid>
          </Grid>
        </Border>
      </Border>
      <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Outline}" Cursor="SizeWE" KeyboardIncrement="8" AutomationProperties.Name="{DynamicResource '文件树宽度'}"/>
      <Grid Grid.Column="2" x:Name="EditorArea" ClipToBounds="True">
        <Grid x:Name="PhotoArea" SizeChanged="PhotoAreaSizeChanged">
          <Grid.RowDefinitions><RowDefinition x:Name="NeutralRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="NeutralColumn" Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <local:PhotoCanvas x:Name="NeutralCanvas" Grid.Row="1" Margin="0"/>
          <local:PhotoCanvas x:Name="ResultCanvas" Grid.Row="1" Grid.Column="1"/>
          <local:HDRSurface x:Name="NeutralHDRSurface" Grid.Row="1" Visibility="Hidden"/>
          <local:HDRSurface x:Name="ResultHDRSurface" Grid.Row="1" Grid.Column="1" Visibility="Hidden"/>
          <Border x:Name="HslTargetBanner" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="560" Margin="12" Padding="10" Background="{DynamicResource OverlaySurface}" CornerRadius="8" AutomationProperties.AutomationId="hsl.target.canvas">
            <StackPanel>
              <WrapPanel><TextBlock x:Name="HslTargetBannerTitle" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="{DynamicResource '退出目标调整'}" Click="ExitHslTargetClicked" AutomationProperties.AutomationId="hsl.target.exit"/></WrapPanel>
              <TextBlock Text="{DynamicResource '拖动照片调整颜色；退出目标模式后可平移。'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource EditorCaptionSize}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Grid x:Name="BusyIndicator" Grid.RowSpan="2" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="{DynamicResource '正在显影…'}"><ProgressBar x:Name="BusyAnimation" Height="2" Foreground="{DynamicResource Indicator}" Background="{DynamicResource ProgressSurface}" IsIndeterminate="True"/><Border x:Name="BusyStill" Background="{DynamicResource Indicator}" Visibility="Collapsed"/></Grid>
          <Canvas x:Name="PhotoLabels" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="NeutralLabel" Background="{DynamicResource OverlaySurface}" CornerRadius="4" Padding="9,5" Visibility="Collapsed"><TextBlock Text="{DynamicResource '调整前'}" FontSize="{DynamicResource EditorBodySize}" TextWrapping="Wrap"/></Border>
            <Border x:Name="FilmLabel" Background="{DynamicResource OverlaySurface}" CornerRadius="4" Padding="9,5" Visibility="Collapsed"><TextBlock x:Name="FilmLabelText" Text="{DynamicResource '调整后'}" FontSize="{DynamicResource EditorBodySize}" TextWrapping="Wrap"/></Border>
          </Canvas>
          <Button x:Name="InfoEntryButton" Grid.RowSpan="2" Grid.ColumnSpan="2" Click="InfoClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Width="32" Height="32" Padding="6" Visibility="Collapsed" ToolTip="{DynamicResource '照片信息'}" AutomationProperties.Name="{DynamicResource '照片信息'}"><local:EditorIcon Kind="Info" Width="18" Height="18"/></Button>
          <Border x:Name="InfoOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,54,14,14" Background="{DynamicResource OverlaySurface}" CornerRadius="5" Padding="10,7" MaxWidth="380" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel><TextBlock x:Name="InfoFileText" FontSize="{DynamicResource EditorBodySize}" TextWrapping="Wrap"/><TextBlock x:Name="InfoCaptureText" FontSize="{DynamicResource EditorBodySize}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
          </Border>
          <StackPanel x:Name="Welcome" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <local:EditorIcon Kind="Folder" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,18" TextElement.Foreground="{DynamicResource Muted}"/>
            <TextBlock Text="{DynamicResource '打开照片'}" FontSize="{DynamicResource EditorEmptySize}" Foreground="{DynamicResource Foreground}" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="{DynamicResource '拖入照片，或添加目录开始浏览'}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14"/>
            <WrapPanel HorizontalAlignment="Center"><Button Content="{DynamicResource '打开 RAW'}" Click="OpenClicked" MinWidth="128" Margin="4,10" Style="{StaticResource AccentButton}"/><Button Content="{DynamicResource '添加目录'}" Click="AddFolderClicked" Margin="4,10"/></WrapPanel>
          </StackPanel>
        </Grid>
        <Grid x:Name="SelectionWorkspace" Visibility="Collapsed" AutomationProperties.AutomationId="workspace.selection">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="SelectionHeadingHost"/>
          <ListBox x:Name="SelectionGallery" Grid.Row="1" Style="{StaticResource WorkspacePhotoList}" Margin="10" AutomationProperties.AutomationId="workspace.selection.scroll"/>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock x:Name="SelectionGalleryNotice" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button x:Name="SelectionAddDirectory" Content="{DynamicResource '添加目录'}" Click="AddFolderClicked" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <DockPanel x:Name="SelectionActions" Grid.Row="2" Margin="10,4" Visibility="Collapsed">
            <Button DockPanel.Dock="Right" Content="{DynamicResource '加入选片集合'}" Click="AddWorkspaceSelectionClicked" Style="{StaticResource AccentButton}" AutomationProperties.AutomationId="workspace.selection.add"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource '清空选择'}" Click="ClearWorkspaceSelectionClicked" Style="{StaticResource QuietButton}"/>
            <TextBlock x:Name="WorkspaceSelectionCount" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="workspace.selection.count"/>
          </DockPanel>
        </Grid>
        <Grid x:Name="LibraryOverlay" Visibility="Collapsed">
          <Button Click="DismissLibraryDrawer" Background="{DynamicResource OverlaySurface}" Opacity=".55" BorderThickness="0" Focusable="False" Margin="0" Padding="0" AutomationProperties.Name="{DynamicResource '收起文件树'}"/>
          <Border x:Name="LibraryDrawer" Width="264" HorizontalAlignment="Left"/>
        </Grid>
      </Grid>
      <GridSplitter x:Name="AdjustmentSplitter" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Outline}" Cursor="SizeWE" KeyboardIncrement="8" AutomationProperties.Name="{DynamicResource '调整栏'}" AutomationProperties.AutomationId="workspace.inspector.resize"/>
      <Popup x:Name="HistogramPopup" PlacementTarget="{Binding ElementName=HistogramButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border x:Name="HistogramPopupContent" Width="280" Padding="12" Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="6"/>
      </Popup>
        <Border x:Name="AdjustmentPanel" Grid.Column="4" Background="{DynamicResource Surface}" Padding="10,4,10,6" ClipToBounds="True" AutomationProperties.AutomationId="workspace.inspector">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="DockHeader">
              <DockPanel MinHeight="32">
                <Button x:Name="ResetAllButton" Click="ResetMenuClicked" DockPanel.Dock="Right" Padding="6,3" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '重置调整'}" AutomationProperties.Name="{DynamicResource '重置调整'}"><local:EditorIcon Kind="Reset" Width="18" Height="18"/></Button>
                <TextBlock Text="{DynamicResource '调整栏'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <Border x:Name="HistogramSurface" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,1" Padding="0,3" Visibility="Collapsed">
                <DockPanel>
                  <Button x:Name="HistogramInlineButton" DockPanel.Dock="Top" Click="HistogramClicked" Style="{StaticResource ToolButton}" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="workspace.histogram.inline">
                    <StackPanel Orientation="Horizontal"><local:EditorIcon Kind="ChevronDown" Width="14" Height="14"/><TextBlock x:Name="HistogramHeading" Text="{DynamicResource 'RGB 直方图'}" FontWeight="SemiBold" Margin="6,0,0,0"/></StackPanel>
                  </Button>
                  <Grid x:Name="HistogramHost">
              <Grid x:Name="HistogramPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="HistogramTitle" Text="{DynamicResource 'RGB 直方图'}" FontSize="{DynamicResource EditorCaptionSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="HistogramSource" Grid.Row="1" Margin="0,4,0,0" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="Wrap"/>
                <local:HistogramView x:Name="Histogram" Grid.Row="2" Height="92" Margin="2,8"/>
                <TextBlock x:Name="ClipStats" Grid.Row="3" FontSize="{DynamicResource EditorCaptionSize}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
              </Grid>
                  </Grid>
                </DockPanel>
              </Border>
              <WrapPanel x:Name="Groups" Margin="0,4"/>
              <local:ParameterRow x:Name="LookStrengthRow" Visibility="Collapsed" AutomationProperties.AutomationId="workspace.lookStrength"/>
            </StackPanel>
            <Popup x:Name="ProcessingPopup" PlacementTarget="{Binding ElementName=ProcessingSettingsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
              <Border Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" Padding="16" CornerRadius="6" Width="330">
                <ScrollViewer x:Name="EditorContextScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource '照片处理设置'}" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ActiveFilm" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource '处理版本'}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProcessingVersion" SelectedIndex="2" SelectionChanged="ProcessingVersionChanged" AutomationProperties.Name="{DynamicResource '处理版本'}"><ComboBoxItem Content="{DynamicResource '处理 v1（旧版）'}"/><ComboBoxItem Content="{DynamicResource '处理 v2'}"/><ComboBoxItem Content="{DynamicResource '处理 v3'}"/></ComboBox>
                    <TextBlock x:Name="ProcessingMigrationState" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RollbackProcessingMigrationButton" Content="{DynamicResource '回到迁移前'}" Click="RollbackProcessingMigrationClicked" Margin="0,8,0,0" Padding="8,3" Style="{StaticResource QuietButton}" Visibility="Collapsed"/>
                    <StackPanel x:Name="X3fSettingsPanel" Visibility="Collapsed">
                      <TextBlock Text="{DynamicResource 'X3F 显影'}" Margin="0,10,0,4"/>
                      <ComboBox x:Name="X3fRendering" SelectionChanged="X3fRenderingChanged" AutomationProperties.Name="{DynamicResource 'X3F 显影'}" AutomationProperties.AutomationId="x3f.mode">
                        <ComboBoxItem Content="{DynamicResource '伪红外（旧版）'}"/>
                        <ComboBoxItem x:Name="X3fNormalOption" Content="{DynamicResource '正常显影'}"/>
                      </ComboBox>
                      <TextBlock x:Name="X3fDescription" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource '曝光基准'}" Margin="0,10,0,4"/>
                    <ComboBox x:Name="ExposureMode" SelectedIndex="0" SelectionChanged="ExposureModeChanged" AutomationProperties.Name="{DynamicResource '曝光基准'}"><ComboBoxItem Content="{DynamicResource '标准显影'}"/><ComboBoxItem Content="{DynamicResource '匹配内嵌预览'}"/><ComboBoxItem Content="{DynamicResource '传感器基准'}"/></ComboBox>
                    <TextBlock x:Name="BaselineLabel" Text="{DynamicResource '基础偏移 —'}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Button Content="{DynamicResource '拍摄时白平衡'}" x:Name="AsShotButton" Click="AsShotClicked" Padding="8,3" Margin="0,10,0,0" Style="{StaticResource QuietButton}"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Popup>
            <ScrollViewer x:Name="ToolsScroller" Grid.Row="1" Margin="0,0,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Tools">
              <Button x:Name="FilmCategory" Click="FilmCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '选择胶片模拟'}" AutomationProperties.Name="{DynamicResource '胶片'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="FilmCategoryRing"/><local:EditorIcon Kind="Film" Width="16" Height="16"/></Grid>
                  <TextBlock Text="{DynamicResource '胶片'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="MasterRecipeCategory" Click="MasterRecipeCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '选择大师配方'}" AutomationProperties.Name="{DynamicResource '大师配方'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="MasterRecipeCategoryRing"/><local:EditorIcon Kind="Photo" Width="16" Height="16"/></Grid><TextBlock Text="{DynamicResource '大师配方'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="DenoiseCategory" Click="DenoiseCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '降噪'}" AutomationProperties.Name="{DynamicResource '降噪'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="DenoiseCategoryRing"/><local:EditorIcon Kind="Denoise" Width="16" Height="16"/></Grid><TextBlock Text="{DynamicResource '降噪'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="LensCategory" Click="LensCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '镜头匹配'}" AutomationProperties.Name="{DynamicResource '镜头'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="LensCategoryRing"/><local:EditorIcon Kind="Lens" Width="16" Height="16"/></Grid><TextBlock Text="{DynamicResource '镜头'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="GeometryCategory" Click="GeometryCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '裁切、旋转、翻转和拉直'}" AutomationProperties.Name="{DynamicResource '几何'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="GeometryCategoryRing"/><local:EditorIcon Kind="Geometry" Width="16" Height="16"/></Grid><TextBlock Text="{DynamicResource '裁切'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="PerspectiveCategory" Click="PerspectiveCategoryClicked" Style="{StaticResource ToolButton}" AutomationProperties.Name="{DynamicResource '透视'}" AutomationProperties.AutomationId="Perspective">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:EditorIcon Kind="Perspective" Width="16" Height="16"/></Grid><TextBlock Text="{DynamicResource '透视'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="HslCategory" Click="HslCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="HSL" AutomationProperties.Name="HSL">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="HslCategoryRing"/><local:EditorIcon Kind="Hsl" Width="16" Height="16"/></Grid><TextBlock Text="HSL" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="GradingCategory" Click="GradingCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '颜色分级'}" AutomationProperties.Name="{DynamicResource '颜色分级'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="GradingCategoryRing"/><local:EditorIcon Kind="ColorGrading" Width="16" Height="16"/></Grid><TextBlock Text="{DynamicResource '颜色分级'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="WhiteBalanceCategory" Click="WhiteBalanceCategoryClicked" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '白平衡'}" AutomationProperties.Name="{DynamicResource '白平衡'}" AutomationProperties.AutomationId="WhiteBalance">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="18" Height="18"><local:AdjustmentRing Compact="True" x:Name="WhiteBalanceCategoryRing"/><local:EditorIcon Kind="Temperature" Width="16" Height="16"/></Grid><TextBlock Text="{DynamicResource '白平衡'}" FontSize="{DynamicResource EditorCaptionSize}" TextWrapping="NoWrap" TextAlignment="Left" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Button>
            <Grid x:Name="ToolBody" Margin="3,3,3,7">
            <StackPanel x:Name="ParameterPanel" Margin="0,5">
              <local:ParameterRow x:Name="OrdinaryParameter"/>
              <WrapPanel HorizontalAlignment="Center">
              <Button x:Name="AutoExposureButton" Click="AutoExposureClicked" ToolTip="{DynamicResource '自动调整曝光'}" AutomationProperties.Name="{DynamicResource '自动调整曝光'}" Padding="8,3" Style="{StaticResource QuietButton}"><StackPanel Orientation="Horizontal"><local:EditorIcon Kind="Auto" Width="18" Height="18"/><TextBlock Text="{DynamicResource '自动'}" Margin="5,0,0,0"/></StackPanel></Button>
              <Button x:Name="ResetGroupButton" Content="{DynamicResource '重置分组'}" Click="ResetGroupClicked" Padding="8,3" Style="{StaticResource QuietButton}"/>
              </WrapPanel>
            </StackPanel>
            <ContentControl x:Name="QuickPresetSurface" Visibility="Collapsed" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="preset.quick.panel"/>
            <Grid x:Name="FilmPanel" Visibility="Collapsed" Margin="0,3,0,0" AutomationProperties.AutomationId="looks.browser">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,6">
                <ComboBox x:Name="LookCategory" MinHeight="30" SelectionChanged="LookCategoryChanged" AutomationProperties.Name="{DynamicResource '外观分类'}" AutomationProperties.AutomationId="looks.category"/>
                <DockPanel Margin="0,4,0,0">
                  <Button x:Name="LookSearchClear" DockPanel.Dock="Right" Content="×" Padding="5,0" Visibility="Collapsed" Click="ClearLookSearch" AutomationProperties.Name="{DynamicResource '清除搜索'}" AutomationProperties.AutomationId="looks.search.clear"/>
                  <TextBox x:Name="LookSearch" MinHeight="30" VerticalContentAlignment="Center" TextChanged="LookSearchChanged" ToolTip="{DynamicResource '搜索外观'}" AutomationProperties.Name="{DynamicResource '搜索外观'}" AutomationProperties.AutomationId="looks.search"/>
                </DockPanel>
                <Button x:Name="LookImport" Content="{DynamicResource '导入外观'}" Click="ImportClicked" HorizontalAlignment="Left" Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="looks.import"/>
              </StackPanel>
              <UniformGrid x:Name="FilmStrip" Grid.Row="1" Columns="3" VerticalAlignment="Top"/>
              <StackPanel x:Name="LookEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="looks.empty">
                <TextBlock Text="{DynamicResource '没有匹配的外观'}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="LookEmptyAction" Click="ClearLookSearch" Margin="0,6"/>
              </StackPanel>
            </Grid>
            <Border x:Name="MasterRecipePanel" Visibility="Collapsed">
              <UniformGrid x:Name="RecipeStrip" Columns="2" VerticalAlignment="Top"/>
            </Border>
            <Border x:Name="DenoiseSurface" Visibility="Collapsed"><local:DenoisePanel x:Name="DenoiseEditor"/></Border>
            <Border x:Name="LensSurface" Visibility="Collapsed"><local:LensPanel x:Name="LensEditor"/></Border>
            <Border x:Name="GeometrySurface" Visibility="Collapsed"><local:GeometryPanel x:Name="GeometryEditor"/></Border>
            <Border x:Name="HslSurface" Visibility="Collapsed"><local:HslPanel x:Name="HslEditor"/></Border>
            <Border x:Name="GradingSurface" Visibility="Collapsed"><local:ColorGradingPanel x:Name="GradingEditor"/></Border>
            <Border x:Name="CurveSurface" Visibility="Collapsed"><local:ToneCurvePanel x:Name="CurveEditor"/></Border>
            <Border x:Name="WhiteBalanceSurface" Visibility="Collapsed"><local:WhiteBalancePanel x:Name="WhiteBalanceEditor"/></Border>
            <Border x:Name="PhotoEffectsSurface" Visibility="Collapsed">
              <local:PhotoEffectsPanel x:Name="PhotoEffectsEditor"/>
            </Border>
            </Grid>
            </StackPanel></ScrollViewer>
            <DockPanel x:Name="DraftActions" Grid.Row="2" Visibility="Collapsed" Margin="0,4,0,0">
              <WrapPanel DockPanel.Dock="Right"><Button x:Name="CancelDraftButton" Content="{DynamicResource '取消'}" Click="CancelDraftClicked"/><Button x:Name="ApplyDraftButton" Content="{DynamicResource '应用'}" Click="ApplyDraftClicked"/></WrapPanel>
              <TextBlock Text="{DynamicResource '草稿尚未应用'}" VerticalAlignment="Center" Foreground="{DynamicResource Indicator}" TextWrapping="Wrap"/>
            </DockPanel>
            <DockPanel Grid.Row="3" Margin="0,5,0,0">
              <Button x:Name="ProcessingSettingsButton" Click="ProcessingSettingsClicked" DockPanel.Dock="Right" Padding="6,3" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource '照片处理设置'}" AutomationProperties.Name="{DynamicResource '照片处理设置'}" AutomationProperties.AutomationId="processing.settings"><local:EditorIcon Kind="Processing" Width="18" Height="18"/></Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource '当前外观'}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource EditorCaptionSize}"/>
                <TextBlock x:Name="InspectorLook" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
    </Grid>
    <Border Grid.Row="3" MinHeight="40" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0">
      <DockPanel Margin="14,0">
        <Button x:Name="ExportRevealButton" DockPanel.Dock="Right" ToolTip="{DynamicResource '在资源管理器中查看'}" AutomationProperties.Name="{DynamicResource '在资源管理器中查看'}" Click="OpenExportedClicked" Visibility="Collapsed" Style="{StaticResource QuietButton}" Width="36" Padding="6,2"><local:EditorIcon Kind="Folder" Width="18" Height="18"/></Button>
        <Button x:Name="BatchNotice" DockPanel.Dock="Right" ToolTip="{DynamicResource '继续上次批量任务'}" AutomationProperties.Name="{DynamicResource '继续上次批量任务'}" Click="ShowBatchClicked" Visibility="Collapsed" Style="{StaticResource QuietButton}" Width="36" Padding="6,2"><local:EditorIcon Kind="Library" Width="18" Height="18"/></Button>
        <Button x:Name="RetrySave" DockPanel.Dock="Right" ToolTip="{DynamicResource '重试保存'}" AutomationProperties.Name="{DynamicResource '重试保存'}" Click="RetrySaveClicked" Visibility="Collapsed" Style="{StaticResource QuietButton}" Width="36" Padding="6,2"><local:EditorIcon Kind="Reset" Width="18" Height="18"/></Button>
        <TextBlock x:Name="SaveState" DockPanel.Dock="Right" MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center" FontSize="{DynamicResource EditorCaptionSize}" AutomationProperties.LiveSetting="Polite"/>
        <ComboBox x:Name="GpuMode" DockPanel.Dock="Right" MinWidth="116" SelectedIndex="0" SelectionChanged="GpuModeChanged" Margin="10,2,0,2" AutomationProperties.Name="{DynamicResource '渲染加速'}"><ComboBoxItem Content="{DynamicResource 'GPU 自动'}"/><ComboBoxItem Content="{DynamicResource '仅 CPU'}"/><ComboBoxItem Content="{DynamicResource '强制 GPU'}"/></ComboBox>
        <TextBlock x:Name="BackendLabel" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
        <Button x:Name="RetryButton" ToolTip="{DynamicResource '重试'}" AutomationProperties.Name="{DynamicResource '重试'}" Click="RetryClicked" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource QuietButton}" Width="36" Padding="6,2" Margin="6,0"><local:EditorIcon Kind="Reset" Width="18" Height="18"/></Button>

        <TextBlock x:Name="Status" Text="{DynamicResource '就绪'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
  </Grid>
