<UserControl x:Class="RawLab.Windows.GeometryPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RawLab.Windows" MaxWidth="720">
 <UserControl.Resources>
  <Style x:Key="FlipToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="3,0"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Surface" Background="Transparent" CornerRadius="4" Padding="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel Margin="4">
  <StackPanel x:Name="CropControls">
   <WrapPanel Margin="0,0,0,6">
    <ComboBox x:Name="AspectBox" MinWidth="120" SelectionChanged="AspectChanged" AutomationProperties.Name="{DynamicResource '画面比例'}"/>
    <Button x:Name="AspectLock" Click="LockClicked" ToolTip="{DynamicResource '锁定当前比例'}" AutomationProperties.Name="{DynamicResource '锁定当前比例'}" AutomationProperties.AutomationId="geometry.lockCropAspect"><local:EditorIcon x:Name="LockIcon" Kind="Unlock" Width="18" Height="18"/></Button>
    <Button x:Name="SwapAspect" Click="SwapClicked" ToolTip="{DynamicResource '交换横纵比例'}" AutomationProperties.Name="{DynamicResource '交换横纵比例'}"><local:EditorIcon Kind="Swap" Width="18" Height="18"/></Button>
    <Button Click="RotateLeftClicked" ToolTip="{DynamicResource '向左旋转 90°'}" AutomationProperties.Name="{DynamicResource '向左旋转 90°'}"><local:EditorIcon Kind="RotateLeft" Width="18" Height="18"/></Button>
    <Button Click="RotateRightClicked" ToolTip="{DynamicResource '向右旋转 90°'}" AutomationProperties.Name="{DynamicResource '向右旋转 90°'}"><local:EditorIcon Kind="RotateRight" Width="18" Height="18"/></Button>
    <CheckBox x:Name="HorizontalFlip" Style="{StaticResource FlipToggle}" Checked="FlipChanged" Unchecked="FlipChanged" ToolTip="{DynamicResource '水平翻转'}" AutomationProperties.Name="{DynamicResource '水平翻转'}"><local:EditorIcon Kind="FlipHorizontal" Width="18" Height="18"/></CheckBox>
    <CheckBox x:Name="VerticalFlip" Style="{StaticResource FlipToggle}" Checked="FlipChanged" Unchecked="FlipChanged" ToolTip="{DynamicResource '垂直翻转'}" AutomationProperties.Name="{DynamicResource '垂直翻转'}"><local:EditorIcon Kind="FlipVertical" Width="18" Height="18"/></CheckBox>
    <CheckBox x:Name="GridBox" Content="{DynamicResource '三分网格'}" IsChecked="True" Checked="GridChanged" Unchecked="GridChanged" Margin="8,4" VerticalAlignment="Center"/>
    <Button x:Name="ResetGeometry" Click="ResetClicked" ToolTip="{DynamicResource '重置几何编辑'}" AutomationProperties.Name="{DynamicResource '重置几何编辑'}"><local:EditorIcon Kind="Reset" Width="18" Height="18"/></Button>
   </WrapPanel>
   <StackPanel x:Name="TransformRows"/>
   <Expander x:Name="PreciseCrop" Header="{DynamicResource '位置与尺寸'}" PreviewMouseDown="PreciseCropPressed" PreviewKeyDown="PreciseCropKeyDown">
    <Grid x:Name="CropRows" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions></Grid>
   </Expander>
  </StackPanel>
  <StackPanel x:Name="PerspectiveRows" Visibility="Collapsed"/>
 </StackPanel>
</UserControl>
