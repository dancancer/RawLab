<UserControl x:Class="RawLab.Windows.PhotoEffectsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RawLab.Windows" MaxWidth="720">
 <StackPanel Margin="4">
  <DockPanel>
   <Button x:Name="ResetGroupButton" DockPanel.Dock="Right" Click="ResetGroupClicked" ToolTip="{DynamicResource '重置当前效果'}" AutomationProperties.Name="{DynamicResource '重置当前效果'}" Padding="6,2"><local:EditorIcon Kind="Reset" Width="16" Height="16"/></Button>
   <TextBlock x:Name="Title" VerticalAlignment="Center" FontWeight="SemiBold"/>
  </DockPanel>
  <StackPanel x:Name="VignetteParameters"/>
  <Expander x:Name="VignetteDetails" Header="{DynamicResource '精细调整'}"><StackPanel x:Name="VignetteFineParameters"/></Expander>
  <StackPanel x:Name="GrainParameters"/>
 </StackPanel>
</UserControl>
