<UserControl x:Class="RawLab.Windows.PhotoEffectsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RawLab.Windows" MaxWidth="720">
 <StackPanel Margin="4">
  <!-- 工具条上已经选中“暗角”或“颗粒”，这里只留分组重置，不再重复工具名 -->
  <Button x:Name="ResetGroupButton" HorizontalAlignment="Right" Click="ResetGroupClicked" ToolTip="{DynamicResource '重置当前效果'}" AutomationProperties.Name="{DynamicResource '重置当前效果'}" Padding="6,2"><local:EditorIcon Kind="Reset" Width="16" Height="16"/></Button>
  <StackPanel x:Name="VignetteParameters"/>
  <Expander x:Name="VignetteDetails" Header="{DynamicResource '精细调整'}"><StackPanel x:Name="VignetteFineParameters"/></Expander>
  <StackPanel x:Name="GrainParameters"/>
 </StackPanel>
</UserControl>
