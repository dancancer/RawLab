<UserControl x:Class="RawLab.Windows.LensPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RawLab.Windows" MaxWidth="800">
 <StackPanel Margin="4">
  <WrapPanel VerticalAlignment="Center">
   <RadioButton x:Name="Automatic" Content="{DynamicResource '自动'}" GroupName="LensMode" Checked="ModeChanged" Margin="0,4,12,4" AutomationProperties.Name="{DynamicResource '镜头匹配'}"/>
   <RadioButton x:Name="Manual" Content="{DynamicResource '手动'}" GroupName="LensMode" Checked="ModeChanged" Margin="0,4,20,4" AutomationProperties.Name="{DynamicResource '选择镜头'}"/>
   <CheckBox x:Name="Distortion" Content="{DynamicResource '畸变矫正'}" AutomationProperties.Name="{DynamicResource '畸变矫正'}" Checked="SwitchChanged" Unchecked="SwitchChanged" Margin="0,4,16,4"/>
   <CheckBox x:Name="Tca" Content="{DynamicResource '横向色差'}" AutomationProperties.Name="{DynamicResource '横向色差'}" Checked="SwitchChanged" Unchecked="SwitchChanged" Margin="0,4,16,4"/>
   <CheckBox x:Name="AutoCrop" Content="{DynamicResource '自动裁边'}" AutomationProperties.Name="{DynamicResource '自动裁边'}" Checked="SwitchChanged" Unchecked="SwitchChanged" Margin="0,4,16,4"/>
   <Button Click="ResetClicked" ToolTip="{DynamicResource '重置镜头校正'}" AutomationProperties.Name="{DynamicResource '重置镜头校正'}" Padding="6,3"><local:EditorIcon Kind="Reset" Width="16" Height="16"/></Button>
  </WrapPanel>
  <Button x:Name="ProfileButton" Click="ChooseClicked" HorizontalContentAlignment="Left" Margin="0,4" Padding="8,4" AutomationProperties.Name="{DynamicResource '选择镜头配置文件'}">
   <TextBlock x:Name="SelectedTitle" Text="{DynamicResource '选择镜头'}" TextTrimming="CharacterEllipsis"/>
  </Button>
  <WrapPanel><TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,12,0" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="CropText" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></WrapPanel>
  <Popup x:Name="Chooser" PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
   <Border Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" Padding="8" CornerRadius="4" Width="500">
    <StackPanel>
     <TextBox x:Name="Search" TextChanged="SearchChanged" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource '搜索镜头'}"/>
     <ListBox x:Name="Profiles" MaxHeight="260" SelectionChanged="ProfileChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource '镜头配置'}">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,4"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Calibration}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="EmptyText" Text="{DynamicResource '未找到镜头'}" Foreground="{DynamicResource Muted}" Margin="4" Visibility="Collapsed"/>
    </StackPanel>
   </Border>
  </Popup>
 </StackPanel>
</UserControl>
