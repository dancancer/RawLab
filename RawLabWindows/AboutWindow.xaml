<Window x:Class="RawLab.Windows.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RawLab.Windows"
        Title="{DynamicResource '关于 RawLab'}" Style="{StaticResource {x:Type Window}}" Width="500" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Icon="AppIcon.png">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <!-- “关闭”放在滚动区之外：窗口受最大高度限制时，正文滚动，按钮始终完整可见 -->
  <DockPanel>
    <Button Content="{DynamicResource '关闭'}" IsCancel="True" Click="CloseClicked" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="24,8,24,20"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,24,24,8" TextElement.Foreground="{DynamicResource Foreground}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <Image Source="AppIcon.png" Width="64" Height="64" Margin="0,0,16,0"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="RawLab" FontSize="22" FontWeight="Bold"/>
            <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,0"><Run x:Name="VersionRun"/></TextBlock></StackPanel>
        </StackPanel>
        <Separator/>
        <TextBlock Text="{DynamicResource '语言'}" Margin="0,12,0,4"/>
        <ComboBox x:Name="LanguageBox" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectionChanged="LanguageChanged" MinWidth="200" HorizontalAlignment="Left"/>
        <TextBlock Text="{DynamicResource '项目与作者'}" FontWeight="SemiBold" Margin="0,16,0,8"/>
        <TextBlock Margin="0,4"><Hyperlink Click="RepositoryClicked" Foreground="{DynamicResource Indicator}"><Run Text="{DynamicResource 'GitHub 仓库'}"/></Hyperlink></TextBlock>
        <TextBlock Margin="0,8,0,16"><Hyperlink Click="AuthorClicked" Foreground="{DynamicResource Indicator}"><Run Text="{DynamicResource '作者的小红书主页'}"/></Hyperlink></TextBlock>
        <Separator/>
        <CheckBox Content="{DynamicResource '自动检查更新'}" IsChecked="{Binding Automatic, Mode=TwoWay}" Foreground="{DynamicResource Foreground}" Margin="0,16,0,12"/>
        <CheckBox x:Name="UsageConsent" Content="{DynamicResource '允许使用统计'}" Checked="UsageConsentChanged" Unchecked="UsageConsentChanged" Foreground="{DynamicResource Foreground}" Margin="0,0,0,6"/>
        <TextBlock x:Name="UsageStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{DynamicResource '开启后，由阿里云处理功能使用次数，数据存储在中国大陆；SDK 可能采集设备标识、设备与系统信息、网络/IP、地区及会话信息。不采集照片、预览、文件名、路径、EXIF 或 AI 内容。关闭后停止新采集，已发出的请求无法撤回。'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,6"/>
        <TextBlock Text="{DynamicResource '为统计活跃设备数，应用会在本机保存一个随机生成的安装标识，不含个人信息；关闭统计时一并删除。'}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
        <TextBlock Margin="0,0,0,12"><Hyperlink Click="PrivacyClicked" Foreground="{DynamicResource Indicator}"><Run Text="{DynamicResource '阿里云隐私政策'}"/></Hyperlink></TextBlock>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding StorageWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Indicator}" Margin="0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,8">
          <Button Click="CheckClicked" IsEnabled="{Binding CanCheck}" AutomationProperties.Name="{DynamicResource '检查更新'}">
            <StackPanel Orientation="Horizontal"><local:EditorIcon Kind="Reset" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource '检查更新'}"/></StackPanel>
          </Button>
          <Button Content="{DynamicResource '前往下载'}" Click="DownloadClicked" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding Available.Notes}" TextWrapping="Wrap"/>
        </ScrollViewer>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
