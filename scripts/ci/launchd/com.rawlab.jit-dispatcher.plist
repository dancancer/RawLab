<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Example LaunchAgent for the opt-in JIT dispatcher (WP-01). Nothing in CI loads this file:
     copy it to ~/Library/LaunchAgents/com.rawlab.jit-dispatcher.plist on one Apple pool Mac,
     create ~/RawLabCI/jit.env with mode 0600 (`chmod 600 ~/RawLabCI/jit.env`) containing
     `RAWLAB_JIT_TOKEN=<fine-grained-PAT>` (never put the token in this plist), adjust the paths
     to that host, and bootstrap it only after the resident Runner.Listener agent has been stopped.
     --runner-dir must be a FRESH actions/runner directory (unpack the pinned runner archive
     with `tar -xzf <archive> -C ~/jit-runner`; never point it at the resident runner directory,
     or the JIT run would overwrite and deregister the resident .runner/.credentials, whose
     .runner_migrated marker makes a JIT launch crash on the spot). Copy only the provisioned
     environment files in — `cp <resident-runner>/.path <resident-runner>/.env ~/jit-runner/`
     (never .runner*/.credentials*/.service): the Apple jobs need that PATH plus DEVELOPER_DIR
     and cache keys. The fresh archive root ships ./run.sh (./runsvc.sh appears only after
     `svc.sh install`), which the dispatcher launches with the JIT config in the environment.
     Symlink `~/jit-runner/_work -> /Volumes/RawLabCI/_work` to keep workspaces on the pool
     volume while generate-jitconfig keeps its default relative work_folder.
     Enable/disable steps: docs/process/ci.md (JIT Dispatcher for Self-Hosted Jobs). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rawlab.jit-dispatcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.12</string>
        <string>/Users/rawlab-ci/RawLab/scripts/ci/jit_dispatch.py</string>
        <string>--repo</string>
        <string>dancancer/RawLab</string>
        <string>--runner-dir</string>
        <string>/Users/rawlab-ci/jit-runner</string>
        <string>--launch-command</string>
        <string>./run.sh</string>
        <string>--interval</string>
        <string>30</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Path to the 0600 env file holding RAWLAB_JIT_TOKEN (never store the token in this
             plist). Fine-grained PAT scoped to dancancer/RawLab: repository Administration (write)
             for generate-jitconfig plus Actions (read) for the queue poll; classic PAT: repo. -->
        <key>RAWLAB_JIT_ENV_FILE</key>
        <string>/Users/rawlab-ci/RawLabCI/jit.env</string>
        <!-- Empty default: only push runs on this repository are claimed. Entries are comma-
             separated @head_sha-pinned targets, e.g. pr#42@<sha>,777@<sha>,octo/RawLab:branch@<sha>. -->
        <key>RAWLAB_JIT_ALLOWLIST</key>
        <string></string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/rawlab-ci/RawLab</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/rawlab-ci/Library/Logs/com.rawlab.jit-dispatcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rawlab-ci/Library/Logs/com.rawlab.jit-dispatcher.log</string>
</dict>
</plist>
