  "compatibility_scenarios": [
    {
      "id": "compat-legacy-omitted-extensions",
      "description": "Legacy persisted SDR record omitting processing, x3fMode, masterRecipeSettingsVersion, and optional extension sub-objects must decode cleanly with legacy v1 defaults.",
      "base_record_id": "raster-sdr-neutral",
      "kind": "legacy_omitted_extensions",
      "omit_scopes": ["processing", "x3f_mode", "master_recipe_settings_version", "tone_controls", "atmosphere", "color_grading", "tone_curve", "hdr", "hdr_camera_ai", "pro_raw_decode_version"],
      "expect": {
        "status": "load_with_legacy_defaults",
        "processing_version": 1,
        "x3f_mode": "legacy"
      }
    },
    {
      "id": "compat-dormant-hdr-and-proraw-preserved-across-sdr-reset",
      "description": "SDR full reset and save/reopen must preserve dormant HDR subtree, proRAWDecodeVersion, processing version (v2), and x3fMode (legacy).",
      "base_record_id": "full-sdr-raw-dormant-hdr",
      "kind": "sdr_reset_preserves_dormant_hdr",
      "expect": {
        "status": "preserve_dormant_hdr_and_versions",
        "processing_version": 2,
        "x3f_mode": "legacy",
        "pro_raw_decode_version": 2
      }
    },
    {
      "id": "compat-future-processing-version-isolates-and-preserves",
      "description": "Record with unsupported future processing.version=99 must fail per-record read as unusable without crashing store, breaking sibling record, or losing raw bytes when sibling saves.",
      "base_record_id": "full-sdr-raw-dormant-hdr",
      "sibling_record_id": "raster-sdr-neutral",
      "kind": "future_processing_version",
      "processing_version": 99,
      "expect": {
        "target_status": "reject_record_unusable",
        "sibling_status": "readable",
        "preserve_unreadable_bytes_on_sibling_save": true
      }
    },
    {
      "id": "compat-corrupt-entry-isolates-and-preserves",
      "description": "Corrupt JSON/value on one record must isolate cleanly to that entry while keeping healthy siblings readable and preserving raw store entry across sibling writes.",
      "base_record_id": "full-sdr-raw-dormant-hdr",
      "sibling_record_id": "raster-sdr-neutral",
      "kind": "corrupt_entry",
      "expect": {
        "target_status": "reject_record_unusable",
        "sibling_status": "readable",
        "preserve_unreadable_bytes_on_sibling_save": true
      }
    },
    {
      "id": "compat-negative-zero-canonicalized",
      "description": "Negative zero (-0.0) in persisted numeric fields must load cleanly and compare equal to canonical +0.0.",
      "base_record_id": "raster-sdr-neutral",
      "kind": "negative_zero",
      "expect": {
        "status": "load_canonical_zero"
      }
    }
  ],
